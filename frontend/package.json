{
  "name": "cronos-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-marketing-pages.mjs && node scripts/write-build-revision.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:dead-code": "knip --no-progress",
    "lint:dead-code:production": "knip --production --no-progress",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:critical": "vitest run --mode critical",
    "test:critical:coverage": "vitest run --mode critical --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=public",
    "test:e2e:ui": "playwright test --ui",
    "audit:production": "node scripts/audit-production.mjs",
    "test:marketing-assets": "node scripts/audit-marketing-assets.mjs",
    "test:marketing-build": "node --test scripts/build-marketing-pages.test.mjs scripts/write-build-revision.test.mjs",
    "test:scripts": "node --test ../scripts/test.test.mjs ../scripts/verify-production-deploy.test.mjs scripts/verify-production-browser.test.mjs",
    "test:legal-contract": "node --test scripts/verify-legal-version-contract.test.mjs && node scripts/verify-legal-version-contract.mjs",
    "legal-manifest:update": "node scripts/verify-legal-version-contract.mjs --write",
    "verify:checks": "npm run lint && npm run lint:dead-code && npm run lint:dead-code:production && npm run test:legal-contract && npm run test:marketing-build && npm run test:scripts && node --test scripts/edge-worker.test.mjs && npm run test:marketing-assets",
    "verify": "npm run verify:checks && npm run test:coverage && npm run build",
    "verify:critical:fast": "npm run test:legal-contract && npm run test:marketing-build && node --test scripts/edge-worker.test.mjs && npm run test:marketing-assets && npm run test:critical:coverage"
  },
  "dependencies": {
    "@clerk/localizations": "^4.23.0",
    "@clerk/react": "^6.17.8",
    "@coreui/coreui": "^5.9.1",
    "@coreui/icons": "^3.1.0",
    "@coreui/icons-react": "^2.3.0",
    "@coreui/react": "^5.13.1",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clerk/backend": "^3.23.2",
    "@clerk/testing": "^2.2.45",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "msw": "3.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
