{
  "name": "cronos-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-marketing-pages.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:dead-code": "knip --no-progress",
    "lint:dead-code:production": "knip --production --no-progress",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=public",
    "test:e2e:ui": "playwright test --ui",
    "audit:production": "node scripts/audit-production.mjs",
    "test:marketing-assets": "node scripts/audit-marketing-assets.mjs",
    "test:marketing-build": "node --test scripts/build-marketing-pages.test.mjs",
    "verify": "npm run lint && npm run lint:dead-code && npm run lint:dead-code:production && npm run test:marketing-build && npm run test:marketing-assets && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@clerk/localizations": "^4.15.2",
    "@clerk/react": "^6.6.2",
    "@coreui/coreui": "^5.4.3",
    "@coreui/icons": "^3.0.1",
    "@coreui/icons-react": "^2.3.0",
    "@coreui/react": "^5.9.1",
    "@tanstack/react-query": "^5.90.8",
    "axios": "^1.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clerk/backend": "^3.11.0",
    "@clerk/testing": "^2.2.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "knip": "^6.25.0",
    "msw": "2.15.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
