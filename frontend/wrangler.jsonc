{
  "name": "cronos-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-website",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "RESEND_API_KEY"] },
  "routes": [{ "pattern": "cronos.pt", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
