# This key is public and is embedded in the frontend build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_TURNSTILE_SITE_KEY=replace-with-a-turnstile-test-site-key

# Contact provider credentials stay server-side.
RESEND_API_KEY=replace-with-a-resend-test-key
TURNSTILE_SECRET_KEY=replace-with-a-turnstile-test-secret
