{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "celery -A app.celery_worker.celery_app worker --loglevel=info --include=app.scheduler_recovery_worker --pool=solo --concurrency=1 --prefetch-multiplier=1 --queues=scheduler-supervisor --hostname=scheduler-supervisor@%h --beat --schedule /tmp/celerybeat-schedule",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
