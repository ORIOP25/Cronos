{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "celery -A app.celery_worker.celery_app worker --loglevel=info --include=app.scheduler_v1_worker --concurrency=1 --prefetch-multiplier=1 --max-tasks-per-child=1",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
