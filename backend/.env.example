# Ficheiro: .env.example
# Copia este ficheiro para .env e preenche com valores reais.
# O ficheiro .env NUNCA deve ser comitado (já está no .gitignore).

# --- Base de Dados ---
# Formato: postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]
DATABASE_URL="postgresql+asyncpg://postgres:<SENHA>@localhost:5432/horario_zen_db"

# --- Segurança JWT ---
# Gera uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CHAVE_SECRETA_ALEATORIA_64_CHARS>

# --- Ambiente ---
# Valores aceites: local | staging | production
ENVIRONMENT=local

# --- Celery / Redis ---
CELERY_BROKER_URL="redis://localhost:6379/0"
REDIS_URL="redis://localhost:6379/0"

# --- Solver ---
# Versão do motor de horários: v1 | v2
SOLVER_ENGINE_VERSION=v2
# Número de semanas da janela rolling (V2)
SOLVER_V2_ROLLING_WEEKS=8

# --- Sentry (Opcional) ---
# Deixa vazio ou comenta para desativar em desenvolvimento local.
SENTRY_DSN=
# Sample rate de tracing (0.0 a 1.0). 1.0 = 100% (só para debug).
SENTRY_TRACES_SAMPLE_RATE=0.1
